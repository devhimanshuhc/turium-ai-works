{
	"name": "turium-knowledge-inbox",
	"private": true,
	"version": "1.0.0",
	"scripts": {
		"build": "turbo run build",
		"start": "turbo run start",
		"dev": "turbo run dev",
		"db:up": "docker compose up -d --wait db",
		"db:down": "docker compose down",
		"db:migrate": "pnpm --filter server db:migrate",
		"prepare": "lefthook install",
		"ready": "pnpm lint:fix && pnpm typecheck",
		"lint": "biome check",
		"lint:fix": "biome check --write && turbo run lint:fix",
		"format": "biome format --write",
		"gitleaks": "node scripts/gitleaks.mjs",
		"doctor": "react-doctor -y",
		"doctor:staged": "react-doctor --staged --blocking error -y",
		"typecheck": "turbo run typecheck",
		"package": "turbo run package",
		"test": "turbo run test",
		"test:watch": "turbo run test:watch",
		"test:cov": "turbo run test:cov",
		"clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/server/.venv"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"lefthook": "^2.2.2",
		"react-doctor": "0.9.23",
		"turbo": "^2.11.13",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@tanstack/markdown": "^1.2.1",
		"axios": "^1.21.1",
		"sonner": "^2.0.8",
		"zod": "^4.6.7"
	}
}
