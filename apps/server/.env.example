LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_inbox

# Set ONE provider. It powers answers, the judge and embeddings.
# If both are set, OpenAI wins.
OPENAI_API_KEY=
# OPENAI_ANSWER_MODEL=gpt-4.1
# OPENAI_FAST_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
# "studio" for a Google AI Studio key, "vertex" for a Vertex AI (express) key
GEMINI_ENDPOINT=studio
# GEMINI_ANSWER_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
